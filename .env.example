# Prumo — copie para .env e ajuste.
# O mesmo arquivo serve para o desenvolvimento (make dev) e para o self-host (docker compose).

# --- Banco (usado pelo compose) ---
POSTGRES_USER=prumo
# Troque a senha em produção. Ela entra na URL de conexão da API: use letras, números, - e _
# (ou codifique os demais caracteres, como @ -> %40).
POSTGRES_PASSWORD=prumo
POSTGRES_DB=prumo

# --- API ---
# Conexão usada pela API rodando fora do Docker (make dev). No compose de produção,
# a API monta a URL a partir das variáveis POSTGRES_* acima.
PRUMO_DATABASE_URL=postgresql+psycopg://prumo:prumo@localhost:5432/prumo
# Banco dos testes (sobe junto no docker-compose.dev.yml, em memória)
PRUMO_TEST_DATABASE_URL=postgresql+psycopg://prumo:prumo@localhost:5433/prumo_test

# Cookie de sessão só por HTTPS. Mantenha true atrás de um proxy com TLS.
# Com true, o login web por http:// (fora de localhost) não funciona. O make dev usa false.
PRUMO_COOKIE_SECURE=true
PRUMO_SESSION_DAYS_WEB=30
PRUMO_SESSION_DAYS_APP=180
# Validade de uma sessão web sem "Manter conectado"
PRUMO_SESSION_HOURS_WEB_TRANSIENT=12

PRUMO_DEFAULT_TIMEZONE=America/Sao_Paulo
PRUMO_DEFAULT_LOCALE=pt-BR
PRUMO_DEFAULT_CURRENCY=BRL

PRUMO_UPLOADS_DIR=/data/uploads
# Origens extras permitidas (CORS), separadas por vírgula. Vazio = mesma origem apenas.
PRUMO_CORS_ORIGINS=

# --- Web ---
# Única porta publicada pelo container web
PRUMO_PORT=8080
