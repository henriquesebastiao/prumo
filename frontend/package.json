{
  "name": "prumo-web",
  "version": "0.0.0",
  "private": true,
  "license": "AGPL-3.0-or-later",
  "type": "module",
  "engines": {
    "node": ">=26"
  },
  "scripts": {
    "dev": "vite",
    "build": "vue-tsc --build && vite build",
    "preview": "vite preview",
    "typecheck": "vue-tsc --build",
    "lint": "eslint . && stylelint --allow-empty-input \"src/**/*.{css,vue}\" && prettier --check .",
    "format": "prettier --write . && eslint . --fix && stylelint \"src/**/*.{css,vue}\" --fix",
    "test": "vitest run",
    "test:watch": "vitest",
    "gen:api": "openapi-typescript ../openapi/openapi.json --default-non-nullable false -o src/lib/api/schema.d.ts && prettier --write src/lib/api/schema.d.ts",
    "screenshots": "playwright test && ./e2e/compare.sh"
  },
  "dependencies": {
    "@fontsource-variable/figtree": "5.3.0",
    "@lucide/vue": "1.70.0",
    "@tanstack/vue-query": "5.105.3",
    "openapi-fetch": "0.17.0",
    "pinia": "4.1.0",
    "reka-ui": "2.11.0",
    "vue": "3.5.45",
    "vue-i18n": "11.4.17",
    "vue-router": "5.4.0",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@playwright/test": "1.64.1",
    "@tsconfig/node26": "26.0.1",
    "@types/node": "26.6.6",
    "@vitejs/plugin-vue": "6.0.10",
    "@vue/eslint-config-prettier": "10.2.0",
    "@vue/eslint-config-typescript": "14.9.0",
    "@vue/test-utils": "2.5.1",
    "@vue/tsconfig": "0.9.1",
    "eslint": "10.14.0",
    "eslint-plugin-vue": "10.12.0",
    "globals": "17.14.0",
    "jsdom": "30.1.3",
    "openapi-typescript": "7.13.0",
    "postcss-html": "2.0.0",
    "prettier": "3.9.10",
    "stylelint": "17.16.0",
    "stylelint-config-recommended-vue": "2.0.0",
    "stylelint-config-standard": "40.0.0",
    "stylelint-declaration-strict-value": "1.12.1",
    "typescript": "6.0.3",
    "typescript-eslint": "8.72.1",
    "vite": "8.3.5",
    "vitest": "5.1.0",
    "vue-tsc": "3.3.14"
  }
}
